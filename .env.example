APP_NAME="Shahzad Labs"
APP_ENV=production
APP_KEY=base64:J1b4f1dPBV9pkfrTg+r8agD7a1dmiRSvRt1adO0BR2s=
APP_DEBUG=false
APP_URL=https://shahzadlabs.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Queue Configuration (Database driver stores jobs in `jobs` table)
# On Hostinger, queued jobs are automatically executed inline upon reply dispatch.
# For high-frequency workers, schedule this command in Hostinger Cron:
# cd /home/u.../public_html && php artisan queue:work --stop-when-empty
# OR ping URL: https://shahzadlabs.com/cron/process-queue?token=shahzadlabs-queue-sync
QUEUE_CONNECTION=database
CRON_TOKEN=shahzadlabs-queue-sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================================================
# MAIL CONFIGURATION (Choose Option A or Option B)
# =========================================================================

# --- OPTION A: Gmail SMTP (Requires 16-character Google App Password) ---
# NOTE: Google disables standard account passwords for SMTP.
# Generate App Password here: https://myaccount.google.com/apppasswords
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=alikhore12@gmail.com
MAIL_PASSWORD="your-16-character-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="alikhore12@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- OPTION B: Hostinger Domain Webmail (Free with your domain in Hostinger hPanel) ---
# In Hostinger hPanel -> Emails -> Create Email (e.g. info@shahzadlabs.com or shahzad@shahzadlabs.com)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=info@shahzadlabs.com
# MAIL_PASSWORD="your_email_password"
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS="info@shahzadlabs.com"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
